<mxfile host="app.diagrams.net"><diagram id="lab3" name="Lab3 Component Diagram"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Smart Lab Equipment Slot Reservation Portal – UML Component Diagram (Epic 2: FR-002 &amp;amp; FR-005)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1160" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Architectural style: Layered Architecture (Presentation → Business → Data) | Team 001 – Problem Statement 001" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1160" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Presentation Layer" style="rounded=1;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="800" height="120" as="geometry"/></mxCell><mxCell id="c5" value="Business Layer" style="rounded=1;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="800" height="180" as="geometry"/></mxCell><mxCell id="c6" value="Data Layer" style="rounded=1;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="800" height="130" as="geometry"/></mxCell><mxCell id="c7" value="External Systems" style="rounded=1;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="900" y="55" width="300" height="200" as="geometry"/></mxCell><mxCell id="c8" value="&lt;i style='font-size:10px'&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;Web Portal UI&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;Student view: book equipment and see a clear message if calibration is invalid or expired. Technician view: update availability and calibration status; current status shown right away (ST-8)&lt;/span&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="100" y="80" width="680" height="80" as="geometry"/></mxCell><mxCell id="c9" value="" style="shape=component;jettyWidth=8;jettyHeight=4;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="756" y="86" width="18" height="14" as="geometry"/></mxCell><mxCell id="c10" value="&lt;i style='font-size:10px'&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;Reservation Manager&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;Confirms a reservation only after a successful calibration check; returns the block message to the student (FR-002; ST-3, ST-4)&lt;/span&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;fillColor=#ffe6a8;strokeColor=#d6b656;strokeWidth=2;fontSize=11;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="100" y="290" width="170" height="110" as="geometry"/></mxCell><mxCell id="c11" value="" style="shape=component;jettyWidth=8;jettyHeight=4;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="246" y="296" width="18" height="14" as="geometry"/></mxCell><mxCell id="c12" value="&lt;i style='font-size:10px'&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;Calibration Service&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;Checks calibration status and expiry of the selected equipment; reports invalid or expired equipment (FR-002; ST-3, ST-4)&lt;/span&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;fillColor=#ffe6a8;strokeColor=#d6b656;strokeWidth=2;fontSize=11;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="290" width="170" height="110" as="geometry"/></mxCell><mxCell id="c13" value="" style="shape=component;jettyWidth=8;jettyHeight=4;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="496" y="296" width="18" height="14" as="geometry"/></mxCell><mxCell id="c14" value="&lt;i style='font-size:10px'&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;Equipment Management&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;Lets authorized technicians update availability and calibration status / expiry; updated status is shown in the portal (FR-005; ST-5, ST-6, ST-7, ST-8)&lt;/span&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;fillColor=#ffe6a8;strokeColor=#d6b656;strokeWidth=2;fontSize=11;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="610" y="290" width="170" height="110" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=component;jettyWidth=8;jettyHeight=4;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="756" y="296" width="18" height="14" as="geometry"/></mxCell><mxCell id="c16" value="&lt;i style='font-size:10px'&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;Database Component&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;Equipment, availability, calibration status &amp;amp; expiry, and reservation tables | persistent storage&lt;/span&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="100" y="530" width="680" height="80" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=component;jettyWidth=8;je